# 케이스 1 — 서버가 보유하는 접속 자격증명. .env 로 복사해 채운다(gitignore).
SQL_MAX_ROWS=200

# (A) 로컬 sqlite — 이 데모 기본 (추가 설치 불필요)
DB_TYPE=sqlite
SQLITE_PATH=../shop.db

# (B) 관리형 PostgreSQL — pip install "psycopg[binary]"
#   접속정보만 채우면 서버가 로그인. 관리형은 SSL 필수 → PGSSLMODE=require
# DB_TYPE=postgres
# PGHOST=db.xxxx.supabase.co
# PGPORT=5432
# PGUSER=readonly_user          # ★ 읽기 전용 계정 권장
# PGPASSWORD=change-me
# PGDATABASE=shop
# PGSSLMODE=require

# (B') 접속 URL 을 통째로 받은 경우(Neon/Heroku/Railway) — user/pass/ssl 이 URL 안에
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# (C) MySQL/MariaDB — pip install pymysql
# DB_TYPE=mysql
# MYSQL_HOST=db.example.com
# MYSQL_PORT=3306
# MYSQL_USER=readonly_user
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=shop

# (D) 클라우드 IAM(AWS RDS 등) — 비번 대신 단기 토큰. server.py connect() 주석 참고.
#     자격증명은 .env 가 아니라 클라우드 크레덴셜(~/.aws 등)에 있고, 코드가 토큰을 발급.
