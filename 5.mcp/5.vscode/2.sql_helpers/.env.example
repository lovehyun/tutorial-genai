# sql-helper 접속 설정 — 이 파일을 .env 로 복사해서 값을 채운다.
#   cp .env.example .env
# .env 는 gitignore 됨(비밀이 커밋되지 않음). 아래 셋 중 하나만 골라 DB_TYPE 을 맞춘다.

# 결과 행 수 상한 (과다 출력 방지)
SQL_MAX_ROWS=200

# ── (A) 로컬 SQLite — 이 예제의 기본/완성본. 추가 설치 불필요 ──
DB_TYPE=sqlite
SQLITE_PATH=./sample.db          # 상대경로면 server.py 폴더 기준

# ── (B) 원격 PostgreSQL — pip install "psycopg[binary]" ──
# DB_TYPE=postgres
# PGHOST=db.example.com
# PGPORT=5432
# PGUSER=readonly_user           # ★ 읽기 전용 계정 권장
# PGPASSWORD=change-me
# PGDATABASE=shop
# PGSSLMODE=require              # 원격은 TLS 권장 (server.py 에서 주석 해제)

# ── (C) 원격 MySQL / MariaDB — pip install pymysql ──
# DB_TYPE=mysql
# MYSQL_HOST=db.example.com
# MYSQL_PORT=3306
# MYSQL_USER=readonly_user       # ★ 읽기 전용 계정 권장
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=shop
